# EduPredict AI - Backend Environment Configuration

# Project Metadata
PROJECT_NAME="EduPredict AI"
API_V1_STR="/api"

# Security (Generate a strong secret key for production)
SECRET_KEY="generate-a-strong-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./edupredict.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://edupredict_user:strongpassword@localhost:5432/edupredict_db"

# Storage Directories
# DATASET_STORAGE_DIR="/var/data/edupredict/datasets"
# ARTIFACT_STORAGE_DIR="/var/data/edupredict/models"

# CORS Configuration
# Comma-separated or JSON list of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
